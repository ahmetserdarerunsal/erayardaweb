# ---------------------------------------------------------------------------
# Ekrem Eray Arda — ortam değişkenleri
#
# Bu dosya ŞABLONDUR, gerçek anahtar içermez. Kopyalayıp doldurun:
#   cp .env.example .env.local
# .env* dosyaları .gitignore içindedir, asla commit edilmez.
#
# Canlı ortamda bu değerler Netlify panelinde tanımlanır:
#   Site configuration > Environment variables
# ---------------------------------------------------------------------------

# Sitenin canlı adresi. Sitemap, robots.txt ve Open Graph adresleri bundan
# üretilir. Statik sayfalar build sırasında üretildiği için bu değişken
# BUILD ortamında da tanımlı olmalıdır.
NEXT_PUBLIC_SITE_URL=https://ornek-alan-adi.com


# ---------------------------------------------------------------------------
# Supabase — veritabanı, kimlik doğrulama ve dosya depolama
#
# Değerler: Supabase panelinde Project Settings > API
# ---------------------------------------------------------------------------

# Proje adresi. Tarayıcıya gönderilir, gizli değildir.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (eski adıyla "anon"). Tarayıcıya gönderilir, gizli DEĞİLDİR.
# Güvenlik RLS politikalarıyla sağlanır, bu anahtarın gizliliğiyle değil.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (eski adıyla "service_role"). RLS'i tamamen atlar.
# ASLA istemciye gönderilmez, yalnızca sunucu tarafında kullanılır.
# Bu anahtar sızarsa tüm veritabanı ele geçirilebilir.
SUPABASE_SECRET_KEY=sb_secret_...


# ---------------------------------------------------------------------------
# İletişim formu
# ---------------------------------------------------------------------------

# Yeni mesaj geldiğinde bildirim gönderilecek adres (isteğe bağlı).
# Boş bırakılırsa e-posta bildirimi gönderilmez, mesaj yine panele düşer.
CONTACT_NOTIFICATION_EMAIL=


# ---------------------------------------------------------------------------
# Yayımlama sonrası önbellek tazeleme
# ---------------------------------------------------------------------------

# Panelden içerik yayımlandığında ilgili sayfaların yeniden üretilmesi için.
# Rastgele uzun bir dize üretin:
#   openssl rand -base64 32
REVALIDATE_SECRET=
